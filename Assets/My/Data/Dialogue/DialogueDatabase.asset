MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d6e68035b0b6c8a418e4ba69a861bf1d, type: 3}
  m_Name: DialogueDatabase
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDatabase
  entries:
  - npcId: 1
    situation: 0
    day: 0
    role: 0
    nodeKey: 
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: Evening. Got a room for one night?
      textKo: "\uC548\uB155\uD558\uC138\uC694. \uD558\uB8FB\uBC24 \uBB35\uC744 \uBC29
        \uC788\uC2B5\uB2C8\uAE4C?"
    - expression: 0
      textEn: Been walking since dawn. I'm done in.
      textKo: "\uC0C8\uBCBD\uBD80\uD130 \uAC78\uC5C8\uC5B4\uC694. \uC644\uC804\uD788
        \uC9C0\uCCE4\uC2B5\uB2C8\uB2E4."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 1
    situation: 0
    day: 0
    role: 1
    nodeKey: name
    labelEn: Ask their name
    labelKo: "\uC774\uB984\uC744 \uBB3B\uB294\uB2E4"
    lines:
    - expression: 0
      textEn: Just call me a traveler. Names don't buy much out here.
      textKo: "\uADF8\uB0E5 \uB098\uADF8\uB124\uB77C\uACE0 \uBD80\uB974\uC138\uC694.
        \uC774\uB7F0 \uB370\uC120 \uC774\uB984 \uB530\uC704 \uC4F8\uBAA8\uC5C6\uC73C\uB2C8\uAE4C."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 1
    situation: 0
    day: 0
    role: 1
    nodeKey: where
    labelEn: Ask where they're headed
    labelKo: "\uC5B4\uB514\uB85C \uAC00\uB294\uC9C0 \uBB3B\uB294\uB2E4"
    lines:
    - expression: 0
      textEn: Somewhere the road stops. You know any place like that?
      textKo: "\uAE38\uC774 \uB05D\uB098\uB294 \uACF3 \uC5B4\uB518\uAC00\uB85C\uC694.
        \uADF8\uB7F0 \uB370 \uC544\uC138\uC694?"
    choices:
    - labelEn: I wish I did
      labelKo: "\uB098\uB3C4 \uC54C\uC558\uC73C\uBA74 \uC88B\uACA0\uB124\uC694"
      goToNode: where_a
    - labelEn: Just take the room
      labelKo: "\uADF8\uB0E5 \uBC29\uC744 \uC4F0\uC138\uC694"
      goToNode: where_b
    goToNode: 
    outcome: 0
  - npcId: 1
    situation: 0
    day: 0
    role: 3
    nodeKey: where_a
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: Yeah. Figured as much.
      textKo: "\uADF8\uB807\uC8E0. \uADF8\uB7F4 \uC904 \uC54C\uC558\uC5B4\uC694."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 1
    situation: 0
    day: 0
    role: 3
    nodeKey: where_b
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: Fair enough. Lead the way.
      textKo: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uC548\uB0B4\uD574 \uC8FC\uC138\uC694."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 1
    situation: 0
    day: 0
    role: 1
    nodeKey: reject
    labelEn: Turn them away
    labelKo: "\uB3CC\uB824\uBCF4\uB0B8\uB2E4"
    lines:
    - expression: 0
      textEn: No room? After all that walking?
      textKo: "\uBC29\uC774 \uC5C6\uB2E4\uACE0\uC694? \uADF8\uB807\uAC8C \uAC78\uC5B4\uC654\uB294\uB370?"
    choices: []
    goToNode: reject_insist
    outcome: 0
  - npcId: 1
    situation: 0
    day: 0
    role: 3
    nodeKey: reject_insist
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: I won't be trouble. Gone by first light.
      textKo: "\uD3D0 \uB07C\uCE58\uC9C0 \uC54A\uC744\uAC8C\uC694. \uB3D9\uD2B8\uBA74
        \uB5A0\uB0A9\uB2C8\uB2E4."
    choices:
    - labelEn: Hold firm
      labelKo: "\uB2E8\uD638\uD558\uAC8C \uAC70\uC808\uD55C\uB2E4"
      goToNode: reject_final
    - labelEn: Reconsider
      labelKo: "\uB2E4\uC2DC \uC0DD\uAC01\uD574 \uBCF8\uB2E4"
      goToNode: 
    goToNode: 
    outcome: 0
  - npcId: 1
    situation: 0
    day: 0
    role: 3
    nodeKey: reject_final
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: ...Fine. I've slept in worse than a ditch.
      textKo: "...\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uB3C4\uB791\uBCF4\uB2E4 \uBABB\uD55C
        \uB370\uC11C\uB3C4 \uC790\uBD24\uC5B4\uC694."
    choices: []
    goToNode: 
    outcome: 2
  - npcId: 1
    situation: 0
    day: 0
    role: 3
    nodeKey: checkin
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: Thank you. You won't hear a sound from me.
      textKo: "\uACE0\uB9D9\uC2B5\uB2C8\uB2E4. \uC18C\uB9AC \uD558\uB098 \uC548 \uB0BC\uAC8C\uC694."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 1
    situation: 1
    day: 0
    role: 0
    nodeKey: 
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: What do you want at this hour?
      textKo: "\uC774 \uC2DC\uAC04\uC5D0 \uBB34\uC2A8 \uC77C\uC774\uC2ED\uB2C8\uAE4C?"
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 1
    situation: 1
    day: 0
    role: 1
    nodeKey: noise
    labelEn: Ask about the noise last night
    labelKo: "\uAC04\uBC24\uC758 \uC18C\uC74C\uC5D0 \uB300\uD574 \uBB3B\uB294\uB2E4"
    lines:
    - expression: 0
      textEn: Noise? I was asleep the whole time.
      textKo: "\uC18C\uC74C\uC774\uC694? \uC800\uB294 \uACC4\uC18D \uC790\uACE0 \uC788\uC5C8\uB294\uB370\uC694."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 2
    situation: 0
    day: 0
    role: 0
    nodeKey: 
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: Ah - yes. Hello. A room. Please. Just the one.
      textKo: "\uC544 - \uB124. \uC548\uB155\uD558\uC138\uC694. \uBC29\uC774\uC694.
        \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4. \uD558\uB098\uBA74 \uB429\uB2C8\uB2E4."
    - expression: 0
      textEn: Long day. Very long. You have no idea.
      textKo: "\uAE34 \uD558\uB8E8\uC600\uC5B4\uC694. \uC544\uC8FC \uAE38\uC5C8\uC8E0.
        \uC0C1\uC0C1\uB3C4 \uBABB \uD558\uC2E4 \uAC81\uB2C8\uB2E4."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 2
    situation: 0
    day: 0
    role: 1
    nodeKey: case
    labelEn: Ask about his suitcase
    labelKo: "\uAC00\uBC29\uC5D0 \uB300\uD574 \uBB3B\uB294\uB2E4"
    lines:
    - expression: 0
      textEn: Samples! Brushes mostly. Nothing you'd want. Nothing at all.
      textKo: "\uACAC\uBCF8\uC785\uB2C8\uB2E4! \uB300\uBD80\uBD84 \uC194\uC774\uC5D0\uC694.
        \uD0D0\uB098\uC2E4 \uB9CC\uD55C \uAC74 \uC5C6\uC5B4\uC694. \uC804\uD600\uC694."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 2
    situation: 0
    day: 0
    role: 1
    nodeKey: shaking
    labelEn: Ask why he's shaking
    labelKo: "\uC65C \uB5A8\uACE0 \uC788\uB294\uC9C0 \uBB3B\uB294\uB2E4"
    lines:
    - expression: 0
      textEn: Cold out. That's all. Just the cold.
      textKo: "\uBC16\uC774 \uCD94\uC6CC\uC11C\uC694. \uADF8\uAC8C \uB2E4\uC785\uB2C8\uB2E4.
        \uADF8\uB0E5 \uCD94\uC704 \uB54C\uBB38\uC774\uC5D0\uC694."
    choices:
    - labelEn: Let it go
      labelKo: "\uB118\uC5B4\uAC04\uB2E4"
      goToNode: 
    - labelEn: Press him
      labelKo: "\uCD94\uAD81\uD55C\uB2E4"
      goToNode: shaking_press
    goToNode: 
    outcome: 0
  - npcId: 2
    situation: 0
    day: 0
    role: 3
    nodeKey: shaking_press
    labelEn: 
    labelKo: 
    lines:
    - expression: 1
      textEn: I said it's the cold! Are we done here?
      textKo: "\uCD94\uC704 \uB54C\uBB38\uC774\uB77C\uACE0 \uD588\uC796\uC544\uC694!
        \uC774\uC81C \uB410\uC2B5\uB2C8\uAE4C?"
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 2
    situation: 0
    day: 0
    role: 1
    nodeKey: reject
    labelEn: Turn them away
    labelKo: "\uB3CC\uB824\uBCF4\uB0B8\uB2E4"
    lines:
    - expression: 0
      textEn: No? Please. I can pay double.
      textKo: "\uC548 \uB41C\uB2E4\uACE0\uC694? \uC81C\uBC1C\uC694. \uB450 \uBC30\uB85C
        \uB0B4\uACA0\uC2B5\uB2C8\uB2E4."
    choices: []
    goToNode: reject_insist
    outcome: 0
  - npcId: 2
    situation: 0
    day: 0
    role: 3
    nodeKey: reject_insist
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: Where else is open? Nowhere. You know that.
      textKo: "\uB2E4\uB978 \uB370\uAC00 \uC5B4\uB514 \uC5F4\uC5C8\uACA0\uC5B4\uC694?
        \uC5C6\uC5B4\uC694. \uC544\uC2DC\uC796\uC544\uC694."
    choices:
    - labelEn: Refuse again
      labelKo: "\uB2E4\uC2DC \uAC70\uC808\uD55C\uB2E4"
      goToNode: reject_2
    - labelEn: Give in
      labelKo: "\uBC1B\uC544\uC900\uB2E4"
      goToNode: 
    goToNode: 
    outcome: 0
  - npcId: 2
    situation: 0
    day: 0
    role: 3
    nodeKey: reject_2
    labelEn: 
    labelKo: 
    lines:
    - expression: 1
      textEn: This is a mistake. You'll see.
      textKo: "\uC774\uAC74 \uC2E4\uC218\uC608\uC694. \uB450\uACE0 \uBCF4\uC138\uC694."
    choices: []
    goToNode: reject_final
    outcome: 0
  - npcId: 2
    situation: 0
    day: 0
    role: 3
    nodeKey: reject_final
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: Fine. FINE. I'm going.
      textKo: "\uC54C\uACA0\uC5B4\uC694. \uC54C\uACA0\uB2E4\uACE0\uC694. \uAC11\uB2C8\uB2E4."
    choices: []
    goToNode: 
    outcome: 2
  - npcId: 2
    situation: 0
    day: 0
    role: 3
    nodeKey: checkin
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: Oh thank you. You won't even know I'm here.
      textKo: "\uC544 \uAC10\uC0AC\uD569\uB2C8\uB2E4. \uC788\uB294 \uC904\uB3C4 \uBAA8\uB974\uC2E4
        \uAC70\uC608\uC694."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 3
    situation: 0
    day: 0
    role: 0
    nodeKey: 
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: Same as always. Key. Now.
      textKo: "\uB298 \uD558\uB358 \uB300\uB85C. \uC5F4\uC1E0. \uB2F9\uC7A5."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 3
    situation: 0
    day: 3
    role: 0
    nodeKey: 
    labelEn: 
    labelKo: 
    lines:
    - expression: 1
      textEn: You're slow tonight. Move it.
      textKo: "\uC624\uB298 \uBC24\uC740 \uAD7C\uB728\uAD70. \uBE68\uB9AC \uD574."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 3
    situation: 0
    day: 0
    role: 1
    nodeKey: wait
    labelEn: Ask him to wait a moment
    labelKo: "\uC7A0\uC2DC \uAE30\uB2E4\uB824 \uB2EC\uB77C\uACE0 \uD55C\uB2E4"
    lines:
    - expression: 1
      textEn: I don't wait. That's your job.
      textKo: "\uB09C \uC548 \uAE30\uB2E4\uB824. \uADF8\uAC8C \uB124 \uC77C\uC774\uC796\uC544."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 3
    situation: 0
    day: 0
    role: 1
    nodeKey: id
    labelEn: Ask for identification
    labelKo: "\uC2E0\uBD84\uC99D\uC744 \uC694\uAD6C\uD55C\uB2E4"
    lines:
    - expression: 0
      textEn: You've seen my face a hundred times.
      textKo: "\uB0B4 \uC5BC\uAD74 \uBC31 \uBC88\uC740 \uBD24\uC796\uC544."
    choices:
    - labelEn: Insist on ID
      labelKo: "\uC2E0\uBD84\uC99D\uC744 \uACC4\uC18D \uC694\uAD6C\uD55C\uB2E4"
      goToNode: id_show
    - labelEn: Wave him through
      labelKo: "\uADF8\uB0E5 \uB4E4\uC5EC\uBCF4\uB0B8\uB2E4"
      goToNode: 
    goToNode: 
    outcome: 0
  - npcId: 3
    situation: 0
    day: 0
    role: 3
    nodeKey: id_show
    labelEn: 
    labelKo: 
    lines:
    - expression: 1
      textEn: Here. Happy? Don't lose it this time.
      textKo: "\uC5EC\uAE30. \uB410\uC5B4? \uC774\uBC88\uC5D4 \uC783\uC5B4\uBC84\uB9AC\uC9C0
        \uB9C8."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 3
    situation: 0
    day: 0
    role: 1
    nodeKey: reject
    labelEn: Turn them away
    labelKo: "\uB3CC\uB824\uBCF4\uB0B8\uB2E4"
    lines:
    - expression: 1
      textEn: Excuse me?
      textKo: "\uBB50\uB77C\uACE0?"
    choices: []
    goToNode: reject_insist
    outcome: 0
  - npcId: 3
    situation: 0
    day: 0
    role: 3
    nodeKey: reject_insist
    labelEn: 
    labelKo: 
    lines:
    - expression: 1
      textEn: You do NOT turn me away. Not me.
      textKo: "\uB0A0 \uB3CC\uB824\uBCF4\uB0B8\uB2E4\uACE0? \uB098\uB97C?"
    choices:
    - labelEn: Stand your ground
      labelKo: "\uBB3C\uB7EC\uC11C\uC9C0 \uC54A\uB294\uB2E4"
      goToNode: reject_final
    - labelEn: Back down
      labelKo: "\uBB3C\uB7EC\uC120\uB2E4"
      goToNode: 
    goToNode: 
    outcome: 0
  - npcId: 3
    situation: 0
    day: 0
    role: 3
    nodeKey: reject_final
    labelEn: 
    labelKo: 
    lines:
    - expression: 1
      textEn: You'll regret this. Count on it.
      textKo: "\uD6C4\uD68C\uD558\uAC8C \uB420 \uAC70\uB2E4. \uD2C0\uB9BC\uC5C6\uC774."
    choices: []
    goToNode: 
    outcome: 2
  - npcId: 3
    situation: 0
    day: 0
    role: 3
    nodeKey: checkin
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: Finally.
      textKo: "\uB4DC\uB514\uC5B4."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 4
    situation: 0
    day: 0
    role: 0
    nodeKey: 
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: A room. Away from the road if you have one.
      textKo: "\uBC29 \uD558\uB098\uC694. \uAC00\uB2A5\uD558\uBA74 \uAE38\uC5D0\uC11C
        \uBA3C \uCABD\uC73C\uB85C."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 4
    situation: 0
    day: 0
    role: 1
    nodeKey: road
    labelEn: Ask why away from the road
    labelKo: "\uC65C \uAE38\uC5D0\uC11C \uBA3C \uCABD\uC778\uC9C0 \uBB3B\uB294\uB2E4"
    lines:
    - expression: 0
      textEn: I sleep lighter than most.
      textKo: "\uC800\uB294 \uC7A0\uADC0\uAC00 \uBC1D\uC740 \uD3B8\uC774\uC5D0\uC694."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 4
    situation: 0
    day: 0
    role: 1
    nodeKey: alone
    labelEn: Ask if she's travelling alone
    labelKo: "\uD63C\uC790 \uC5EC\uD589 \uC911\uC778\uC9C0 \uBB3B\uB294\uB2E4"
    lines:
    - expression: 0
      textEn: Is that a requirement?
      textKo: "\uADF8\uAC8C \uC870\uAC74\uC778\uAC00\uC694?"
    choices:
    - labelEn: Ask gently
      labelKo: "\uBD80\uB4DC\uB7FD\uAC8C \uBB3B\uB294\uB2E4"
      goToNode: alone_soft
    - labelEn: Ask straight
      labelKo: "\uB2E8\uB3C4\uC9C1\uC785\uC801\uC73C\uB85C \uBB3B\uB294\uB2E4"
      goToNode: alone_hard
    goToNode: 
    outcome: 0
  - npcId: 4
    situation: 0
    day: 0
    role: 3
    nodeKey: alone_soft
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: ...Yes. Alone.
      textKo: "...\uB124. \uD63C\uC790\uC608\uC694."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 4
    situation: 0
    day: 0
    role: 3
    nodeKey: alone_hard
    labelEn: 
    labelKo: 
    lines:
    - expression: 1
      textEn: That's my business. Not yours.
      textKo: "\uADF8\uAC74 \uC81C \uC77C\uC774\uC5D0\uC694. \uB2F9\uC2E0 \uC77C\uC774
        \uC544\uB2C8\uB77C."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 4
    situation: 0
    day: 0
    role: 1
    nodeKey: reject
    labelEn: Turn them away
    labelKo: "\uB3CC\uB824\uBCF4\uB0B8\uB2E4"
    lines:
    - expression: 0
      textEn: I see.
      textKo: "\uADF8\uB807\uAD70\uC694."
    choices: []
    goToNode: reject_final
    outcome: 0
  - npcId: 4
    situation: 0
    day: 0
    role: 3
    nodeKey: reject_final
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: I'll find somewhere. I always do.
      textKo: "\uC5B4\uB514\uB4E0 \uCC3E\uACA0\uC8E0. \uB298 \uADF8\uB7AC\uC73C\uB2C8\uAE4C."
    choices: []
    goToNode: 
    outcome: 2
  - npcId: 4
    situation: 0
    day: 0
    role: 3
    nodeKey: checkin
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: Good. Don't knock after dark.
      textKo: "\uC88B\uC544\uC694. \uC5B4\uB450\uC6CC\uC9C0\uBA74 \uBB38 \uB450\uB4DC\uB9AC\uC9C0
        \uB9C8\uC138\uC694."
    choices: []
    goToNode: 
    outcome: 0
  - npcId: 5
    situation: 0
    day: 0
    role: 0
    nodeKey: 
    labelEn: 
    labelKo: 
    lines:
    - expression: 0
      textEn: Evening evening! Cold one out there tonight isn't it?
      textKo: "\uC548\uB155\uD558\uC138\uC694 \uC548\uB155\uD558\uC138\uC694! \uC624\uB298
